# Local development configuration — placeholders only. Never commit a real .env file.
APP_ENV=development

# Optional human-friendly demo UI. Keep disabled for normal/local API use.
# When explicitly enabled, /demo is bound only to the deterministic seeded demo tenant.
DEMO_MODE=false

# PostgreSQL (local Compose service; no password is configured for local-only trust auth)
DATABASE_URL=postgresql+psycopg://flyrank@localhost:5432/flyrank_metering

# Runtime-only tenant-proof signing secret. A trusted auth/gateway layer creates
# HMAC-SHA256 proofs for generate, usage, and checkout; never expose it to browsers.
SESSION_SECRET=replace_with_a_long_random_local_secret

# Stripe test mode only
STRIPE_SECRET_KEY=sk_test_replace_with_test_key
STRIPE_PRO_PRICE_ID=price_replace_with_test_price_id
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_webhook_signing_secret
STRIPE_SUCCESS_URL=https://example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://example.com/billing/cancel
