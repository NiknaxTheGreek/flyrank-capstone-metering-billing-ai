import '../../styles/global.css';
const cases=[
 {title:'Term Deposit Customer Ranking',href:'/case-studies/term-deposit',tag:'Applied ML · Ranking',body:'40,000 historical calls ranked with leakage-safe pre-call features, ordered validation and capacity-focused lift.'},
 {title:'Predictive Maintenance for the ATLAS Tile Calorimeter',href:'/case-studies/atlas-tilecal',tag:'Physics · NLP · Time Series · ML',body:'Detector-control alarm logs transformed into spatial and temporal datasets for LSTM forecasting and alarm-type classification.'},
 {title:'From COVID-19 Vaccine Hesitancy to Mpox',href:'/case-studies/nlp-stance',tag:'NLP · Transformers · Public Health',body:'A comparative synthesis of two published studies on human stance labelling, transformer classification and cross-crisis adaptation.'},
 {title:'Potential Talents — HR Candidate Ranking',href:'/case-studies/potential-talents',tag:'NLP · Ranking · Human-in-the-loop',body:'Screening and ranking HR candidates with semantic and domain rules, Word2Vec, PCA–Ridge modelling and out-of-sample validation of management feedback.'},
 {title:'FlyRank Usage Metering & Billing Engine',href:'/case-studies/api-metering-billing',tag:'Backend · FastAPI · PostgreSQL · Stripe',body:'Tenant-scoped API and AI-token metering with quotas, idempotency, Stripe test-mode entitlement sync, cost estimation and monthly reconciliation.'},
 {title:'Pet Insurance Claims & Portfolio Data Platform',href:'/case-studies/pet-insurance-data-platform',tag:'Data Engineering · Snowflake · dbt · CDC',body:'Incremental history capture for mutable insurance data with PostgreSQL, Python, Snowflake, dbt, late-arrival recovery, CDC, orchestration and reliability testing.'},
 {title:'FlyRank Applied Search Intelligence',href:'/case-studies/flyrank-search-intelligence',tag:'Applied ML · Ranking · Search Intelligence',body:'Leakage-safe future-performance risk modelling that combines classification and signed regression into a client-separated top-50 content review ranking.'}
