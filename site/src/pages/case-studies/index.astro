import '../../styles/global.css';
const completed=[
 {title:'Term Deposit Customer Ranking',href:'/case-studies/term-deposit',tag:'Applied ML · Ranking',body:'Ranks eligible bank customers so limited calling capacity can focus on the people most likely to subscribe.'},
 {title:'Predictive Maintenance for the ATLAS Tile Calorimeter',href:'/case-studies/atlas-tilecal',tag:'Physics · NLP · Time Series · ML',body:'Turns detector alarm streams into structured data for predictive-maintenance research and alarm forecasting.'},
 {title:'From COVID-19 Vaccine Hesitancy to Mpox',href:'/case-studies/nlp-stance',tag:'NLP · Transformers · Public Health',body:'Uses human-labelled social-media data and transformer models to study public-health stance across two outbreaks.'},
 {title:'Potential Talents — HR Candidate Ranking',href:'/case-studies/potential-talents',tag:'NLP · Ranking · Human-in-the-loop',body:'Filters and ranks HR candidate profiles to reduce manual screening while keeping the final decision with a human.'},
 {title:'FlyRank Usage Metering & Billing Engine',href:'/case-studies/api-metering-billing',tag:'Backend · FastAPI · PostgreSQL · Stripe',body:'Tracks tenant usage, enforces quotas, prevents double counting and safely synchronises subscription status.'},
 {title:'Pet Insurance Claims & Portfolio Data Platform',href:'/case-studies/pet-insurance-data-platform',tag:'Data Engineering · Snowflake · dbt · CDC',body:'Preserves trustworthy history as insurance claims, customer details and payments change over time.'},
 {title:'FlyRank Applied Search Intelligence',href:'/case-studies/flyrank-search-intelligence',tag:'Applied ML · Ranking · Search Intelligence',body:'Ranks which content pages deserve scarce human review attention first.'}
];
const inProgress=[
 {title:'Reel Good — Movie Discovery Web Application',href:'/case-studies/reel-good-frontend',tag:'React · TypeScript · Frontend',body:'A user-facing movie search and discovery application with routing, genre browsing and account/favourites architecture.'},
 {title:'MonReader — Page-Flip Image Classifier',href:'/case-studies/monreader-computer-vision',tag:'Computer Vision · CNN · ResNet18',body:'A binary image-classification project testing page-flip detection across multiple generalisation conditions.'}
