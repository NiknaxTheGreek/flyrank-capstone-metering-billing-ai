---
import '../styles/global.css';
const completedCases = [
  {title:'FlyRank Applied Search Intelligence',href:'/case-studies/flyrank-search-intelligence',tag:'Applied ML · Ranking · Search Intelligence',body:'Identifies which website pages are most worth reviewing so a content team can focus limited time where performance may be at risk.'},
  {title:'Pet Insurance Claims & Portfolio Data Platform',href:'/case-studies/pet-insurance-data-platform',tag:'Data Engineering · Snowflake · dbt · CDC',body:'Preserves trustworthy insurance history as claims, payments and customer information change over time.'},
  {title:'Term Deposit Customer Ranking',href:'/case-studies/term-deposit',tag:'Applied ML · Ranking',body:'Ranks eligible bank customers so limited sales capacity can focus on the people most likely to subscribe.'},
  {title:'Potential Talents — HR Candidate Ranking',href:'/case-studies/potential-talents',tag:'NLP · Ranking · Human-in-the-loop',body:'Filters and ranks HR candidate profiles to reduce repetitive screening while keeping the final hiring decision with a person.'},
  {title:'From COVID-19 Vaccine Hesitancy to Mpox',href:'/case-studies/nlp-stance',tag:'NLP · Transformers · Public Health',body:'Uses human-labelled social-media data and language models to study public attitudes across two public-health outbreaks.'},
  {title:'Predictive Maintenance for the ATLAS Tile Calorimeter',href:'/case-studies/atlas-tilecal',tag:'Physics · NLP · Time Series · ML',body:'Turns detector alarm history into structured data for alarm classification, forecasting and predictive-maintenance research.'},
  {title:'FlyRank Usage Metering & Billing Engine',href:'/case-studies/api-metering-billing',tag:'Backend · FastAPI · PostgreSQL · Stripe',body:'Tracks tenant usage, prevents double counting, enforces quotas and safely synchronises subscription status.'},
  {title:'MonReader — Robust Page-Turn Classification',href:'/case-studies/monreader-computer-vision',tag:'Computer Vision · CNN · ResNet18',body:'Tests whether page-turn detection remains reliable on later frames and previously unseen recordings, not just a familiar test split.'}
];
const inProgressCases = [
  {title:'Reel Good — Movie Discovery Web Application',href:'/case-studies/reel-good-frontend',tag:'In Progress · React · TypeScript · Frontend',body:'A user-facing movie discovery application with live search, detail pages, routing and account/favourites architecture.'}
];
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Nicholas Perikli — data science, applied machine learning, data engineering, backend and product engineering portfolio."/><title>Nicholas Perikli — Data Science & Applied ML</title></head>
<body>
<header><div class="container nav"><a class="brand" href="/" aria-label="Nicholas Perikli home"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><nav aria-label="Primary"><a href="/">Home</a><a href="/case-studies">Case Studies</a><a href="/about">About</a><a class="cta" href="mailto:nicholasperikli@gmail.com">Contact</a></nav></div></header>
<main>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">Data Science · Applied ML · Data Engineering · NLP</div><h1>From messy real-world problems to credible technical solutions.</h1><p>I use data analysis, machine learning and engineering to turn difficult problems into systems and recommendations that are useful in practice—not just impressive on paper.</p><div class="actions"><a class="cta" href="/case-studies">View case studies</a><a class="cta secondary" href="#assistant">Use portfolio assistant</a></div></div><aside class="hero-aside"><strong>What this portfolio proves</strong>I can take problems from data and system design through modelling, validation, backend implementation and user-facing delivery while keeping the evidence and limitations clear.</aside></div></section>

<section class="proof"><div class="container proof-grid"><blockquote>Evidence first. Method before hype. Decisions that survive scrutiny.</blockquote><p>The work spans machine learning, NLP, computer vision, data engineering, backend systems and scientific computing. Each case study leads with the problem, the evidence and why the work matters before going into technical detail.</p></div></section>

<section class="section" id="case-studies"><div class="container"><div class="eyebrow">Completed work</div><h2 class="section-title">Eight evidence-backed case studies</h2><p class="section-lead">Each project is presented in two layers: a concise “Project at a glance” overview covering the objective, data, method, evaluation and outcome, followed by the full technical detail and supporting evidence.</p><div class="cards">{completedCases.map((c)=><article class="card"><span class="tag">{c.tag}</span><h3>{c.title}</h3><p>{c.body}</p><a href={c.href}>Read case study →</a></article>)}</div><div class="evidence"><div><strong>8</strong>completed case studies</div><div><strong>1</strong>project in progress</div><div><strong>Evidence-led</strong>claims tied to source repositories</div></div></div></section>

<section class="section"><div class="container"><div class="eyebrow">Work in progress</div><h2 class="section-title">Current build</h2><p class="section-lead">This project is included to show current direction, but it remains clearly separated from the completed portfolio.</p><div class="cards">{inProgressCases.map((c)=><article class="card wip"><span class="status-pill">In progress</span><span class="tag">{c.tag}</span><h3>{c.title}</h3><p>{c.body}</p><a href={c.href}>View current project status →</a></article>)}</div></div></section>

<section class="section navy" id="assistant"><div class="container assistant-grid"><div><div class="eyebrow">Portfolio assistant</div><h2 class="section-title">Find the most relevant project quickly.</h2><p>This lightweight site assistant uses verified, pre-written summaries. Its answers use the same concise Objective → Data → Method → Evaluation → Outcome structure as the case studies and do not generate unsupported claims.</p></div><div class="assistant-panel"><form id="assistant-form"><input id="assistant-input" placeholder="Ask about projects, skills or research…" autocomplete="off"/><button type="submit">Ask</button></form><div class="starters"><button type="button" data-q="Tell me about FlyRank Search Intelligence">FlyRank summary</button><button type="button" data-q="Tell me about MonReader">MonReader summary</button><button type="button" data-q="What are Nicholas's strongest skills?">Strongest skills</button></div><div class="answer" id="assistant-answer">Ask about a project for a concise, evidence-grounded summary.</div></div></div></section>

<section class="section"><div class="container about-grid"><aside><div class="eyebrow">Working style</div><h3>Direct. Analytical. Evidence-led.</h3><p>I prefer clear assumptions, explicit trade-offs and results that can be defended rather than merely presented.</p></aside><div><div class="eyebrow">About</div><h2 class="section-title">Research discipline, applied to practical data and software systems.</h2><p>My background connects physics research, data science, NLP, computer vision, backend engineering, data engineering and growing frontend/product work. I am most interested in work where quality depends on careful problem framing, validation, reliability and interpretation—not just fitting an algorithm.</p><p><a href="/about">More about my background →</a></p></div></div></section>
</main>
<footer><div class="container footer-grid"><a class="brand" href="/"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><div class="small"><a href="https://github.com/NiknaxTheGreek" target="_blank" rel="noreferrer">GitHub</a> · <a href="https://www.linkedin.com/in/nicholas-perikli-861ab7172" target="_blank" rel="noreferrer">LinkedIn</a> · <a href="mailto:nicholasperikli@gmail.com">Email</a></div></div></footer>
<script is:inline>
const knowledge=[
 {keys:['flyrank','search','seo','content','visibility'],answer:'Objective: identify which website pages are most worth reviewing when search performance may decline. Data: a large pseudonymised search-performance release, with the final proof-of-concept covering 2,520 pages from 21 clients. Method: combine decline-risk and severity signals into a top-50 review ranking. Evaluation: development results improved over baselines, but classification and ranking did not generalise above baseline on six unseen clients. Outcome: support more focused human review without overstating transfer performance.'},
 {keys:['pet','insurance','snowflake','dbt','data platform'],answer:'Objective: preserve trustworthy insurance history as operational records change. Data: generated customers, pets, policies, claims and payments. Method: a PostgreSQL-to-Snowflake platform with Python and dbt that preserves change history. Evaluation: 25 Python tests, 78/78 dbt build nodes and an 82,956-row replay test. Outcome: more traceable and reliable analytical data for reporting.'},
 {keys:['term','deposit','bank','customer','sales'],answer:'Objective: prioritise eligible bank customers before calls when sales capacity is limited. Data: 40,000 historical calls with a 7.24% subscription rate. Method: compare ranking models using only pre-call information. Evaluation: ordered testing showed Logistic Regression was more robust, with useful lift at limited call depths. Outcome: support more efficient use of fixed calling capacity.'},
 {keys:['potential','talents','candidate','hr','recruitment'],answer:'Objective: reduce repetitive screening of irrelevant HR candidate profiles. Data: 104 supplied candidate records reduced to a clean HR-relevant ranking population. Method: combine semantic and HR-specific filtering with a ranking model. Evaluation: repeated out-of-sample testing showed management feedback changed rankings but did not improve held-out quality. Outcome: reduce manual screening while retaining human hiring decisions.'},
 {keys:['covid','vaccine','vaccination'],answer:'Objective: characterise South African attitudes towards COVID-19 vaccination. Data: about 30,000 manually labelled South African tweets. Method: compare several models including BERT and RoBERTa. Evaluation: RoBERTa produced the strongest three-class result at about 61% F1. Outcome: demonstrate how labelled NLP can support large-scale public-health attitude analysis.'},
 {keys:['mpox','m-pox'],answer:'Objective: test whether COVID-adapted language models transfer to Mpox stance classification. Data: 20,604 manually labelled Mpox tweets. Method: compare lexicon methods with transformer models before and after Mpox-specific fine-tuning. Evaluation: RoBERTa reached 69% F1 after fine-tuning. Outcome: related prior training helps, but domain-specific labelled data remains important.'},
 {keys:['atlas','tilecal','cern','detector','maintenance'],answer:'Objective: assess whether historical ATLAS detector alarms can support earlier identification of equipment problems. Data: TileCal Detector Control System alarm records. Method: text processing and LSTM models for alarm classification and forecasting. Evaluation: the refined classifier reached about 75% accuracy and forecasting error was roughly 12.8–22.9%. Outcome: demonstrate predictive-maintenance potential while remaining a research proof-of-concept.'},
 {keys:['billing','metering','api','stripe','quota'],answer:'Objective: track tenant usage reliably without double-counting requests or granting incorrect subscription access. Data: simulated API/AI-token usage and Stripe test events. Method: a FastAPI/PostgreSQL service for usage, quotas, cost estimates and subscription synchronisation. Evaluation: duplicate requests, quota limits, invalid webhooks and reconciliation are tested explicitly. Outcome: reduce usage-recording, billing-logic and access-control errors.'},
 {keys:['monreader','computer vision','page','flip','resnet'],answer:'Objective: assess whether page-turn detection remains reliable on later frames and unseen recordings. Data: 2,989 labelled frames from 117 reconstructed recordings. Method: compare a custom CNN with pretrained ResNet18 across familiar, unseen-source and later-frame tests. Evaluation: ResNet18 scored 0.995 Macro F1 on the easiest regime but 0.877 under combined source and temporal shift, with missed flips still important. Outcome: support controlled evaluation rather than unrestricted deployment.'},
 {keys:['frontend','reel good','movie','react','typescript'],answer:'Reel Good is still in progress. I built a React/TypeScript movie-discovery application with live OMDb search, movie pages, routing and Firebase account/favourites architecture. Automated tests cover the main frontend flows, but final live Firebase verification is still outstanding, so I keep it separate from the completed case studies.'},
 {keys:['skill','skills','machine learning','ml','data science'],answer:'The strongest themes are applied machine learning, rigorous validation, NLP, computer vision, ranking, time-series modelling, data engineering and backend systems. Across the projects I try to connect technical work to a clear business or operational decision and report limitations rather than hiding them.'}
];
const input=document.getElementById('assistant-input');const answer=document.getElementById('assistant-answer');
function reply(q){const t=q.toLowerCase();let best=null,score=0;for(const item of knowledge){let s=0;for(const k of item.keys){if(t.includes(k))s++;}if(s>score){score=s;best=item;}}answer.textContent=best&&score>0?best.answer:'I do not have enough verified portfolio information to answer that confidently. Try asking about one of the eight completed case studies, Reel Good, or Nicholas\'s strongest skills.';}
document.getElementById('assistant-form').addEventListener('submit',e=>{e.preventDefault();if(input.value.trim())reply(input.value.trim());});
document.querySelectorAll('[data-q]').forEach(b=>b.addEventListener('click',()=>{input.value=b.dataset.q;reply(b.dataset.q);}));
</script>
</body></html>