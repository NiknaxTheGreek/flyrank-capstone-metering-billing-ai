---
import '../../../styles/global.css';
import '../../../styles/tutoring.css';
const enquiry = 'mailto:nicholasperikli@gmail.com?subject=Tutoring%20enquiry%20after%20interactive%20lab';
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
 <meta name="description" content="Explore interactive Mathematics and Physics simulations: projectile motion, secants and tangents, and wave interference. Created by Nicholas Perikli."/>
 <meta name="theme-color" content="#0b1d32"/>
 <title>Interactive Physics & Mathematics Lab — Nicholas Perikli</title>
</head>
<body class="tutor-shell">
<header><div class="container nav"><a class="brand" href="/" aria-label="Nicholas Perikli portfolio"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><nav aria-label="Primary"><a href="/">Portfolio</a><a href="/tutoring">Tutoring</a><a href="/tutoring/lab" aria-current="page">Interactive Lab</a><a class="cta" href={enquiry}>Enquire</a></nav></div></header>
<main>
<section class="lab-hero">
 <div class="container">
  <div class="tutor-breadcrumb"><a href="/tutoring">Tutoring</a> / Interactive Lab</div>
  <span class="tutor-kicker">Learn by experimenting</span>
  <h1>Change one thing. See what happens.</h1>
  <p>Use the sliders and animations to connect physical and mathematical ideas to the equations behind them. Each demonstration has a model, a prediction and something to think about.</p>
  <div class="lab-index"><a href="#motion">01 · Projectile motion</a><a href="#calculus">02 · Derivatives</a><a href="#waves">03 · Wave interference</a><a href="/tutoring/lab/astrophysics">04 · Astrophysics</a><a href="/tutoring/lab/quantum">05 · Quantum Mechanics</a></div>
 </div>
</section>
<section id="motion" class="lab-demo">
 <div class="container">
  <div class="lab-title"><span class="lab-count">01</span><h2>Projectile motion</h2></div>
  <p class="lab-description">Launch an object at an angle. How does changing speed, angle or gravity change its path? This idealised model assumes no air resistance and landing at the launch height.</p>
  <div class="lab-layout">
   <div class="lab-controls" aria-label="Projectile motion controls">
    <div class="control"><label for="motion-speed">Launch speed <output id="motion-speed-value">20 m/s</output></label><input id="motion-speed" type="range" min="6" max="40" step="1" value="20"/></div>
    <div class="control"><label for="motion-angle">Launch angle <output id="motion-angle-value">45°</output></label><input id="motion-angle" type="range" min="10" max="80" step="1" value="45"/></div>
    <div class="control"><label for="motion-gravity">Gravity <output id="motion-gravity-value">9.8 m/s²</output></label><input id="motion-gravity" type="range" min="1.6" max="19.6" step=".1" value="9.8"/></div>
    <div class="lab-buttons"><button class="lab-button" id="motion-play" type="button">▶ Launch</button><button class="lab-button secondary" id="motion-reset" type="button">↺ Reset</button></div>
    <div class="lab-stats">
     <div class="lab-stat"><small>Range</small><strong id="motion-range">40.8 m</strong></div>
     <div class="lab-stat"><small>Peak</small><strong id="motion-height">10.2 m</strong></div>
     <div class="lab-stat"><small>Flight</small><strong id="motion-time">2.89 s</strong></div>
    </div>
   </div>
   <div class="lab-stage">
    <div class="stage-meta"><span>2D ideal motion · y against x</span><span id="motion-current">t = 0.00 s</span></div>
    <svg id="motion-chart" viewBox="0 0 640 310" role="img" aria-label="Projectile path and moving position marker">
     <defs><pattern id="motion-grid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#2b4d65" stroke-width=".8"/></pattern></defs>
     <rect x="50" y="22" width="554" height="250" fill="url(#motion-grid)"/>
     <path d="M50 22V272H604" fill="none" stroke="#b3c9da" stroke-width="1.4"/>
     <path id="motion-path" d="M50 272" fill="none" stroke="#45d0e9" stroke-width="3.5" stroke-linecap="round"/>
     <path id="motion-trail" d="M50 272" fill="none" stroke="#b9eefd" stroke-width="1.5" stroke-dasharray="4 6"/>
     <circle id="motion-dot" cx="50" cy="272" r="8" fill="#fbd38d" stroke="#fff8de" stroke-width="2"/>
     <text x="55" y="15" fill="#c4dbe8" font-size="13">height (m)</text><text x="500" y="296" fill="#c4dbe8" font-size="13">distance (m)</text>
     <text id="motion-y-label" x="12" y="34" fill="#9ebed0" font-size="12">m</text><text id="motion-x-label" x="573" y="267" fill="#9ebed0" font-size="12">m</text><text x="42" y="287" fill="#9ebed0" font-size="12">0</text>
    </svg>
    <div class="stage-foot">Try 30°, 45° and 60°. Are the ranges symmetrical when speed and gravity remain fixed?</div>
   </div>
  </div>
  <div class="lab-note"><strong>Connect the model to the maths.</strong><p>Horizontal: x(t) = v₀ cos(θ) t. Vertical: y(t) = v₀ sin(θ) t − ½gt². At equal starting and landing heights, range R = v₀² sin(2θ)/g. Predict what happens before moving a slider.</p></div>
 </div>
</section>

<section id="calculus" class="lab-demo">
 <div class="container">
  <div class="lab-title"><span class="lab-count">02</span><h2>From secant to tangent</h2></div>
  <p class="lab-description">A secant connects two points on a curve. As those points move closer, its gradient approaches the derivative—the slope of the tangent at one point.</p>
  <div class="lab-layout">
   <div class="lab-controls" aria-label="Calculus controls">
    <div class="control"><label for="calc-function">Function</label><select id="calc-function"><option value="square">f(x) = x²</option><option value="sine">f(x) = sin(x)</option></select></div>
    <div class="control"><label for="calc-x">Position x <output id="calc-x-value">0.5</output></label><input id="calc-x" type="range" min="-1.5" max="1.5" step=".1" value=".5"/></div>
    <div class="control"><label for="calc-h">Gap Δx <output id="calc-h-value">0.80</output></label><input id="calc-h" type="range" min=".05" max=".9" step=".05" value=".8"/></div>
    <div class="lab-buttons"><button class="lab-button" id="calc-approach" type="button">▶ Approach tangent</button><button class="lab-button secondary" id="calc-reset" type="button">↺ Reset</button></div>
    <div class="lab-stats">
     <div class="lab-stat"><small>Secant slope</small><strong id="calc-secant">1.80</strong></div>
     <div class="lab-stat"><small>Tangent slope</small><strong id="calc-tangent">1.00</strong></div>
     <div class="lab-stat"><small>Difference</small><strong id="calc-error">0.80</strong></div>
    </div>
   </div>
   <div class="lab-stage">
    <div class="stage-meta"><span id="calc-stage-function">f(x) = x²</span><span>Δx → 0</span></div>
    <svg id="calc-chart" viewBox="0 0 640 310" role="img" aria-label="Function curve with secant and tangent lines">
     <defs><pattern id="calc-grid" width="35" height="35" patternUnits="userSpaceOnUse"><path d="M35 0H0V35" fill="none" stroke="#2d4d63" stroke-width=".7"/></pattern></defs>
     <rect x="50" y="22" width="554" height="250" fill="url(#calc-grid)"/>
     <path id="calc-x-axis" d="M50 237H604" stroke="#68879d" stroke-width="1.4"/><path d="M327 22V272" stroke="#68879d" stroke-width="1.4"/>
     <path id="calc-curve" fill="none" stroke="#62d4bf" stroke-width="3.5"/>
     <path id="calc-secant-line" stroke="#ffd27c" stroke-width="2.3" stroke-dasharray="9 5"/>
     <path id="calc-tangent-line" stroke="#93b7ff" stroke-width="2.3"/>
     <circle id="calc-a" r="6" fill="#fafcff" stroke="#63d8c0" stroke-width="2"/>
     <circle id="calc-b" r="6" fill="#ffcc73" stroke="#fafcff" stroke-width="1"/>
     <text x="55" y="16" fill="#bdd4e3" font-size="13">f(x)</text><text x="580" y="294" fill="#bdd4e3" font-size="13">x</text>
    </svg>
    <div class="lab-legend"><span><i style="background:#62d4bf"></i>Function</span><span><i style="background:#ffd27c"></i>Secant</span><span><i style="background:#93b7ff"></i>Tangent</span></div>
   </div>
  </div>
  <div class="lab-note"><strong>The definition behind the picture.</strong><p>Derivative at x: f′(x) = lim as Δx → 0 of [f(x + Δx) − f(x)] / Δx. For x², the exact derivative is 2x; for sin(x), it is cos(x), with angles measured in radians. As the gap shrinks, compare the two gradients.</p></div>
 </div>
</section>

<section id="waves" class="lab-demo">
 <div class="container">
  <div class="lab-title"><span class="lab-count">03</span><h2>Wave interference</h2></div>
  <p class="lab-description">Two waves passing through the same point add together. Use the phase difference to move from constructive reinforcement to destructive cancellation.</p>
  <div class="lab-layout">
   <div class="lab-controls" aria-label="Wave interference controls">
    <div class="control"><label for="wave-amplitude">Each wave amplitude <output id="wave-amplitude-value">1.0</output></label><input id="wave-amplitude" type="range" min=".3" max="1.5" step=".1" value="1"/></div>
    <div class="control"><label for="wave-phase">Phase difference <output id="wave-phase-value">0°</output></label><input id="wave-phase" type="range" min="0" max="180" step="5" value="0"/></div>
    <div class="control"><label for="wave-length">Wavelength <output id="wave-length-value">4.0 units</output></label><input id="wave-length" type="range" min="2" max="7" step=".5" value="4"/></div>
    <div class="lab-buttons"><button id="wave-play" class="lab-button" type="button">▶ Animate</button><button id="wave-reset" class="lab-button secondary" type="button">↺ Reset</button></div>
    <div class="lab-stats">
     <div class="lab-stat"><small>Result amplitude</small><strong id="wave-result">2.00</strong></div>
     <div class="lab-stat"><small>Phase</small><strong id="wave-phase-stat">0°</strong></div>
     <div class="lab-stat"><small>Pattern</small><strong id="wave-pattern">Reinforce</strong></div>
    </div>
   </div>
   <div class="lab-stage">
    <div class="stage-meta"><span>Displacement against position</span><span id="wave-status">Paused</span></div>
    <svg id="wave-chart" viewBox="0 0 640 310" role="img" aria-label="Two individual sine waves and their sum">
     <defs><pattern id="wave-grid" width="35" height="35" patternUnits="userSpaceOnUse"><path d="M35 0H0V35" fill="none" stroke="#2d4d63" stroke-width=".7"/></pattern></defs>
     <rect x="25" y="22" width="590" height="258" fill="url(#wave-grid)"/>
     <path d="M25 151H615" stroke="#829cad" stroke-width="1.2"/>
     <path id="wave-one" fill="none" stroke="#58d6eb" stroke-width="2.2"/>
     <path id="wave-two" fill="none" stroke="#c6a9ff" stroke-width="2.2"/>
     <path id="wave-sum" fill="none" stroke="#ffcd81" stroke-width="4"/>
     <text x="30" y="15" fill="#c7dbe7" font-size="13">displacement</text><text x="556" y="298" fill="#c7dbe7" font-size="13">position</text>
    </svg>
    <div class="lab-legend"><span><i style="background:#58d6eb"></i>Wave 1</span><span><i style="background:#c6a9ff"></i>Wave 2</span><span><i style="background:#ffcd81"></i>Resultant</span></div>
   </div>
  </div>
  <div class="lab-note"><strong>Superposition principle.</strong><p>For equal-amplitude waves with the same wavelength and frequency, the sum has amplitude 2A |cos(Δφ/2)|. At 0° they reinforce; at 180° they cancel. This model shows ideal coherent sinusoidal waves.</p></div>
 </div>
</section>

<section class="tutor-section" id="university-lab">
<div class="container">
 <div class="tutor-section-head"><span class="tutor-kicker">Explore university-level physics</span><h2>From planetary orbits to quantum states.</h2><p>The interactive lab now includes dedicated advanced demonstrations, each with the governing equations, adjustable parameters and clearly stated modelling assumptions.</p></div>
 <div class="inprogress-grid">
  <article class="tutor-feature"><span class="feature-no">04 / Astrophysics</span><h3>Keplerian orbits</h3><p>Explore eccentricity, orbital period, distance and velocity around a star.</p><p><a href="/tutoring/lab/astrophysics">Explore the orbit simulation →</a></p></article>
  <article class="tutor-feature"><span class="feature-no">05 / Quantum Mechanics</span><h3>Quantum state and measurement</h3><p>Explore a qubit on the Bloch sphere, relative phase and measurement in different bases.</p><p><a href="/tutoring/lab/quantum">Explore the quantum simulation →</a></p></article>
 </div>
 <p class="tutor-micro" style="margin-top:22px">Structured study notes and a video lesson series are <strong>In Progress</strong>; see the <a href="/tutoring#coming-soon">tutoring overview</a> for details.</p>
</div></section>

<section class="lab-foot">
 <div class="container">
  <span class="tutor-kicker" style="color:#90d9f2">Go deeper</span>
  <h2>Seeing a pattern is the beginning, not the end.</h2>
  <p>In a lesson, we can derive the equations, test what the models assume, and solve realistic problems without memorising disconnected steps.</p>
  <div class="tutor-actions"><a class="cta" href={enquiry}>Ask about tutoring</a><a class="cta secondary" style="color:#fff!important;border-color:#c8dce9" href="/tutoring">Back to tutoring</a></div>
  <p class="tutor-micro" style="color:#a6c2d1;margin-top:22px">These interactive demonstrations are educational models, not laboratory measurements or physical simulators with drag or friction.</p>
 </div>
</section>
</main>
<footer><div class="container footer-grid"><a class="brand" href="/"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><div class="small"><a href="/tutoring">Tutoring</a> · <a href="/">Portfolio</a> · <a href="mailto:nicholasperikli@gmail.com">Email</a></div></div></footer>
<script>
  const $ = (id) => document.getElementById(id);
  const value = (id) => Number($(id).value);
  const set = (id, val) => { $(id).textContent = String(val); };
  const pretty = (n, places = 2) => (Number.isFinite(n) ? n.toFixed(places) : '—');
  const svgNS = 'http://www.w3.org/2000/svg';

  // 01 · Ideal projectile, no aerodynamic drag, equal launch/landing heights.
  let motionProgress = 0, motionRunning = false, motionLast = 0, motionFrame = 0;
  function motionParameters() {
    const speed = value('motion-speed'), theta = value('motion-angle') * Math.PI / 180;
    const g = value('motion-gravity');
    const vx = speed * Math.cos(theta), vy = speed * Math.sin(theta), T = 2*vy/g;
    return {speed,theta,g,vx,vy,T,R:vx*T,H:vy*vy/(2*g)};
  }
  function pointMotion(p,t) {
    const x = p.vx*t, y = Math.max(0,p.vy*t-0.5*p.g*t*t);
    return [50+x/(p.R*1.12)*554,272-y/(Math.max(p.H*1.23,1))*250];
  }
  function renderMotion() {
    const p=motionParameters();
    set('motion-speed-value',p.speed+' m/s');
    set('motion-angle-value',Math.round(p.theta*180/Math.PI)+'°');
    set('motion-gravity-value',pretty(p.g,1)+' m/s²');
    set('motion-range',pretty(p.R,1)+' m');
    set('motion-height',pretty(p.H,1)+' m');
    set('motion-time',pretty(p.T)+' s');
    set('motion-x-label',pretty(p.R*1.12,0));
    set('motion-y-label',pretty(p.H*1.23,0));
    let d='';
    for(let i=0;i<=140;i++){
      const pt=pointMotion(p,p.T*i/140);
      d+=(i===0?'M':'L')+pt[0].toFixed(2)+' '+pt[1].toFixed(2)+' ';
    }
    $('motion-path').setAttribute('d',d);
    const [x,y]=pointMotion(p,p.T*motionProgress);
    $('motion-dot').setAttribute('cx',x);
    $('motion-dot').setAttribute('cy',y);
    set('motion-current','t = '+pretty(p.T*motionProgress)+' s');
  }
  function stopMotion() {
    motionRunning=false;
    cancelAnimationFrame(motionFrame);
    motionFrame=0;
    $('motion-play').textContent='▶ Launch';
  }
  function animateMotion(now) {
    if(!motionRunning)return;
    const dt=Math.min(Math.max(now-motionLast,0),50);
    motionLast=now;
    const p=motionParameters();
    const duration=Math.max(2500,Math.min(7000,p.T*1000));
    motionProgress=Math.min(1,motionProgress+dt/duration);
    renderMotion();
    if(motionProgress>=1){stopMotion();return;}
    motionFrame=requestAnimationFrame(animateMotion);
  }
  for(const id of ['motion-speed','motion-angle','motion-gravity'])
    $(id).addEventListener('input',()=>{stopMotion();motionProgress=0;renderMotion();});
  $('motion-play').addEventListener('click',()=>{
    if(motionRunning){stopMotion();return;}
    if(motionProgress>=1)motionProgress=0;
    motionRunning=true;motionLast=performance.now();
    $('motion-play').textContent='Ⅱ Pause';
    motionFrame=requestAnimationFrame(animateMotion);
  });
  $('motion-reset').addEventListener('click',()=>{stopMotion();motionProgress=0;renderMotion();});

  // 02 · Difference quotient and analytic derivative for two example functions.
  const functions = {
    square:{f:x=>x*x, df:x=>2*x,name:'f(x) = x²',bottom:-1,top:6},
    sine:{f:x=>Math.sin(x),df:x=>Math.cos(x),name:'f(x) = sin(x)',bottom:-1.5,top:1.5}
  };
  function calcDraw() {
    const entry=functions[$('calc-function').value], x=value('calc-x'),h=value('calc-h');
    const y=entry.f(x), next=entry.f(x+h);
    const sec=(next-y)/h, tangent=entry.df(x);
    const xl=-2.4,xr=2.4;
    const sx=v=>50+(v-xl)/(xr-xl)*554;
    const sy=v=>272-(v-entry.bottom)/(entry.top-entry.bottom)*250;
    const line=(slope)=> {
      const x1=xl, x2=xr;
      return 'M'+sx(x1)+' '+sy(y+slope*(x1-x))+'L'+sx(x2)+' '+sy(y+slope*(x2-x));
    };
    let curve='';
    for(let i=0;i<=180;i++){
      const v=xl+(xr-xl)*i/180;
      curve+=(i===0?'M':'L')+sx(v).toFixed(2)+' '+sy(entry.f(v)).toFixed(2)+' ';
    }
    $('calc-curve').setAttribute('d',curve);
    $('calc-secant-line').setAttribute('d',line(sec));
    $('calc-tangent-line').setAttribute('d',line(tangent));
    for(const [id,xx,yy] of [['calc-a',x,y],['calc-b',x+h,next]]) {
      $(id).setAttribute('cx',sx(xx));
      $(id).setAttribute('cy',sy(yy));
    }
    $('calc-x-axis').setAttribute('d','M50 '+sy(0)+' H604');
    set('calc-x-value',pretty(x,1));
    set('calc-h-value',pretty(h,2));
    set('calc-secant',pretty(sec,3));
    set('calc-tangent',pretty(tangent,3));
    set('calc-error',pretty(Math.abs(sec-tangent),3));
    set('calc-stage-function',entry.name);
  }
  let calcRunning=false,calcLast=0,calcFrame=0;
  function stopCalc(){calcRunning=false;cancelAnimationFrame(calcFrame);calcFrame=0;$('calc-approach').textContent='▶ Approach tangent';}
  function animateCalc(now) {
    if(!calcRunning)return;
    const dt=Math.min(Math.max(now-calcLast,0),50);calcLast=now;
    const newH=Math.max(0.05,value('calc-h')-dt*.00028);
    $('calc-h').value=String(newH);
    calcDraw();
    if(newH<=.0501){stopCalc();return;}
    calcFrame=requestAnimationFrame(animateCalc);
  }
  for(const id of ['calc-function','calc-x','calc-h']) $(id).addEventListener('input',()=>{
    stopCalc();calcDraw();
  });
  $('calc-approach').addEventListener('click',()=>{
    if(calcRunning){stopCalc();return;}
    if(value('calc-h')<=.051)$('calc-h').value='.9';
    calcRunning=true;calcLast=performance.now();
    $('calc-approach').textContent='Ⅱ Pause';
    calcFrame=requestAnimationFrame(animateCalc);
  });
  $('calc-reset').addEventListener('click',()=>{
    stopCalc();$('calc-function').value='square';$('calc-x').value='.5';$('calc-h').value='.8';calcDraw();
  });

  // 03 · Ideal coherent waves, equal frequency and amplitude, superposition.
  let waveTime=0,waveRunning=false,waveLast=0,waveFrame=0,waveDrawLast=0;
  function renderWaves(){
    const A=value('wave-amplitude'),deg=value('wave-phase'),lam=value('wave-length');
    const phase=deg*Math.PI/180,k=2*Math.PI/lam;
    const curves=['','',''];
    for(let i=0;i<=220;i++){
      const xpos=16*i/220;
      const v1=A*Math.sin(k*xpos-waveTime);
      const v2=A*Math.sin(k*xpos-waveTime+phase);
      const vals=[v1,v2,v1+v2];
      const sx=25+i/220*590;
      for(let j=0;j<3;j++)curves[j]+=(i===0?'M':'L')+sx.toFixed(2)+' '+(151-vals[j]*36).toFixed(2)+' ';
    }
    $('wave-one').setAttribute('d',curves[0]);
    $('wave-two').setAttribute('d',curves[1]);
    $('wave-sum').setAttribute('d',curves[2]);
    set('wave-amplitude-value',pretty(A,1));
    set('wave-phase-value',deg+'°');
    set('wave-length-value',pretty(lam,1)+' units');
    set('wave-result',pretty(2*A*Math.abs(Math.cos(phase/2))));
    set('wave-phase-stat',deg+'°');
    set('wave-pattern',deg===180?'Cancel':deg<60?'Reinforce':deg>120?'Mostly cancel':'Mixed');
  }
  function stopWave(){waveRunning=false;cancelAnimationFrame(waveFrame);waveFrame=0;$('wave-play').textContent='▶ Animate';set('wave-status','Paused');}
  function animateWave(now){
    if(!waveRunning)return;
    const dt=Math.min(Math.max(now-waveLast,0),50);waveLast=now;
    waveTime+=dt*.0025;
    // Limit expensive SVG path updates to ~30 FPS on mobile devices.
    if(now-waveDrawLast>=33){waveDrawLast=now;renderWaves();}
    waveFrame=requestAnimationFrame(animateWave);
  }
  for(const id of ['wave-amplitude','wave-phase','wave-length'])$(id).addEventListener('input',renderWaves);
  $('wave-play').addEventListener('click',()=>{
    if(waveRunning){stopWave();return;}
    waveRunning=true;waveLast=performance.now();
    $('wave-play').textContent='Ⅱ Pause';
    set('wave-status','Animating');
    waveFrame=requestAnimationFrame(animateWave);
  });
  $('wave-reset').addEventListener('click',()=>{
    stopWave();waveTime=0;$('wave-amplitude').value='1';$('wave-phase').value='0';$('wave-length').value='4';renderWaves();
  });
  // Pause costly animation work when the user switches away or the phone locks.
  function pauseAllAnimations(){stopMotion();stopCalc();stopWave();}
  document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseAllAnimations();});
  window.addEventListener('pagehide',pauseAllAnimations);
  renderMotion();calcDraw();renderWaves();
</script>
</body></html>
