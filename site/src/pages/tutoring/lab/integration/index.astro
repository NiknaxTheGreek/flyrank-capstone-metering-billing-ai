---
import '../../../../styles/global.css';
import '../../../../styles/tutoring.css';
import '../../../../styles/lab-extensions.css';
import Equation from '../../../../components/Equation.astro';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<meta name="description" content="Explore definite integration through interactive left, midpoint, and right Riemann sums."/>
<title>Integration & Riemann Sums — Nicholas Perikli</title></head><body class="tutor-shell">
<header><div class="container nav"><a class="brand" href="/"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><nav aria-label="Primary"><a href="/">Portfolio</a><a href="/tutoring">Tutoring</a><a href="/tutoring/lab">Lab</a><a class="cta" href="mailto:nicholasperikli@gmail.com?subject=Mathematics%20Tutoring%20Enquiry">Enquire</a></nav></div></header>
<main><section class="advanced-hero"><div class="container">
<div class="tutor-breadcrumb"><a href="/tutoring/lab">Interactive Lab</a> / Integration</div>
<span class="tutor-kicker">Mathematics · Calculus · Demonstration 06</span><h1>Build an integral, one rectangle at a time.</h1>
<p>A definite integral is the limiting value of a signed area sum. Try different functions and sample points to see how a Riemann approximation improves.</p>
</div></section>
<section class="advanced-workbench"><div class="container">
<div class="lab-layout">
<div class="lab-controls">
<div class="control"><label for="int-function">Function</label><select id="int-function"><option value="square">f(x) = x²</option><option value="sine">f(x) = sin(x)</option><option value="linear">f(x) = x</option></select></div>
<div class="control"><label for="int-from">Lower limit a <output id="int-from-label">0.0</output></label><input id="int-from" type="range" min="-3" max="2.5" step=".25" value="0"/></div>
<div class="control"><label for="int-to">Upper limit b <output id="int-to-label">2.0</output></label><input id="int-to" type="range" min="-2.5" max="3" step=".25" value="2"/></div>
<div class="control"><label for="int-count">Rectangles n <output id="int-count-label">8</output></label><input id="int-count" type="range" min="4" max="80" step="1" value="8"/></div>
<div class="control"><label for="int-method">Sampling rule</label><select id="int-method"><option value="left">Left endpoint</option><option value="mid">Midpoint</option><option value="right">Right endpoint</option></select></div>
<div class="lab-buttons"><button type="button" class="lab-button" id="int-more">Double rectangles</button><button type="button" class="lab-button secondary" id="int-reset">↺ Reset</button></div>
<div class="extension-stats"><div class="extension-stat"><small>Riemann sum</small><strong id="int-estimate">—</strong></div><div class="extension-stat"><small>Exact integral</small><strong id="int-exact">—</strong></div><div class="extension-stat"><small>Absolute error</small><strong id="int-error">—</strong></div><div class="extension-stat"><small>Rectangle width Δx</small><strong id="int-width">—</strong></div></div>
<p class="extension-control-note" id="int-input-note">The lower limit must be less than the upper limit.</p>
</div>
<div class="lab-stage"><div class="stage-meta"><span>Function and signed rectangular areas</span><span id="int-method-label">Left endpoints</span></div>
<div class="extension-svg"><svg viewBox="0 0 640 350" role="img" aria-label="Function curve and dynamically calculated Riemann rectangles">
<defs><pattern id="int-grid" width="38" height="38" patternUnits="userSpaceOnUse"><path d="M38 0H0V38" fill="none" stroke="#2d4c65" stroke-width=".8"/></pattern></defs>
<rect x="40" y="15" width="580" height="310" fill="url(#int-grid)"/>
<path id="int-axis-x" stroke="#8aa8bd" stroke-width="1.3"/><path id="int-axis-y" stroke="#8aa8bd" stroke-width="1.3"/>
<g id="int-bars"></g>
<path id="int-curve" fill="none" stroke="#ffcf79" stroke-width="3" stroke-linecap="round"/>
<text x="50" y="15" fill="#d5e7f0" font-size="14">f(x)</text><text x="578" y="343" fill="#d5e7f0" font-size="14">x</text>
</svg></div>
<div class="extension-legend"><span class="extension-key" style="--swatch:#ffcf79">Function</span><span class="extension-key" style="--swatch:#4cd1e9">Positive contribution</span><span class="extension-key" style="--swatch:#de8ab8">Negative contribution</span></div>
<div class="extension-stage-info">A negative rectangle counts as negative signed area. A smaller approximation error doesn't always decrease monotonically for every method and function.</div></div>
</div>
<div class="advanced-explanation"><h2>Why this works</h2>
<div class="lab-note"><strong>The Riemann sum</strong><p>Divide the interval from a to b into n strips of width Δx. Multiply each strip's width by the function value at its sample point and add the signed contributions. The integral is the limit of the sums.</p><Equation tex={String.raw`\Delta x=\frac{b-a}{n},\qquad \int_a^b f(x)\,dx=\lim_{n\to\infty}\sum_{i=1}^n f(x_i^*)\Delta x`} label="Riemann sum definition of a definite integral" /></div>
<div class="lab-note"><strong>Signed area matters</strong><p>Sections below the x-axis make negative contributions. An integral is not necessarily the total unsigned geometric area.</p></div>
<div class="lab-note"><strong>Compare methods</strong><p>For a smooth function, midpoint sampling often gives a better estimate than using a left or right endpoint with the same number of rectangles. Verify that rather than assuming it.</p></div>
<div class="extension-footer-links"><a class="cta" href="/tutoring/lab">All ten demonstrations</a><a class="cta secondary" href="/tutoring/lab/electric-fields">Next: Electric Fields</a></div>
</div></div></section></main>
<footer><div class="container footer-grid"><a class="brand" href="/"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><div class="small"><a href="/tutoring">Tutoring</a> · <a href="/tutoring/lab">Interactive Lab</a></div></div></footer>
<script>
const el=id=>document.getElementById(id),number=id=>Number(el(id).value),text=(id,v)=>{el(id).textContent=String(v);};
const defs={
square:{f:x=>x*x,F:x=>x*x*x/3},
sine:{f:x=>Math.sin(x),F:x=>-Math.cos(x)},
linear:{f:x=>x,F:x=>x*x/2}
};
function updateIntegral(source=''){
let a=number('int-from'),b=number('int-to');
if(b-a<.25){
 if(source==='int-from')a=Math.min(a,b-.25);
 else b=Math.max(b,a+.25);
 el('int-from').value=String(a);el('int-to').value=String(b);
}
const f=defs[el('int-function').value].f,F=defs[el('int-function').value].F;
const count=number('int-count'),dx=(b-a)/count,method=el('int-method').value;
const fraction=method==='left'?0:method==='right'?1:.5;
let sum=0,heights=[];
for(let i=0;i<count;i++){const v=f(a+(i+fraction)*dx);heights.push(v);sum+=v*dx;}
const exact=F(b)-F(a);
const values=heights.concat([0]);
for(let i=0;i<=160;i++)values.push(f(a+(b-a)*i/160));
let ymin=Math.min(...values),ymax=Math.max(...values),gap=Math.max(.5,(ymax-ymin)*.18);
ymin-=gap;ymax+=gap;
const xMin=a-(b-a)*.09,xMax=b+(b-a)*.09;
const X=x=>40+(x-xMin)/(xMax-xMin)*580;
const Y=y=>325-(y-ymin)/(ymax-ymin)*310;
const y0=Y(0);
let rects='';
for(let i=0;i<count;i++){
 const left=a+i*dx,v=heights[i],y=Y(v),top=Math.min(y,y0),height=Math.abs(y-y0);
 const width=Math.max(.5,X(left+dx)-X(left)-.8);
 rects+='<rect x="'+X(left).toFixed(2)+'" y="'+top.toFixed(2)+'" width="'+width.toFixed(2)+'" height="'+height.toFixed(2)+'" fill="'+(v>=0?'#4bd0e7':'#e38eb9')+'" fill-opacity=".38" stroke="'+(v>=0?'#7ad9ec':'#ebaacc')+'" stroke-width=".6"/>';
}
el('int-bars').innerHTML=rects;
let d='';
for(let i=0;i<=220;i++){const x=a+(b-a)*i/220;d+=(i?'L':'M')+X(x).toFixed(2)+' '+Y(f(x)).toFixed(2)+' ';}
el('int-curve').setAttribute('d',d);
el('int-axis-x').setAttribute('d','M40 '+y0+' H620');
el('int-axis-y').setAttribute('d','M'+X(0)+' 15 V325');
text('int-from-label',a.toFixed(2));text('int-to-label',b.toFixed(2));text('int-count-label',count);
text('int-estimate',sum.toFixed(4));text('int-exact',exact.toFixed(4));
text('int-error',Math.abs(sum-exact).toFixed(4));text('int-width',dx.toFixed(4));
text('int-method-label',method==='mid'?'Midpoint':method==='left'?'Left endpoints':'Right endpoints');
text('int-input-note','Compare signed-area approximations against the exact antiderivative result.');
}
for(const id of ['int-function','int-from','int-to','int-count','int-method'])
el(id).addEventListener('input',()=>updateIntegral(id));
el('int-more').addEventListener('click',()=>{el('int-count').value=String(Math.min(80,number('int-count')*2));updateIntegral();});
el('int-reset').addEventListener('click',()=>{el('int-function').value='square';el('int-from').value='0';el('int-to').value='2';el('int-count').value='8';el('int-method').value='left';updateIntegral();});
updateIntegral();
</script></body></html>