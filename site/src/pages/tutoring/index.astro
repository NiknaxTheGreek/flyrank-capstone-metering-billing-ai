---
import '../../styles/global.css';
import '../../styles/tutoring.css';

const enquiry = 'mailto:nicholasperikli@gmail.com?subject=Physics%20and%20Mathematics%20Tutoring%20Enquiry&body=Hi%20Nicholas%2C%0A%0AI%27m%20looking%20for%20help%20with%3A%20%0AStudent%20level%3A%20%0ATopics%3A%20%0APreferred%20lesson%20format%3A%20%0A%0AThanks%21';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <meta name="description" content="Physics and Mathematics tutoring with Nicholas Perikli. Clear explanations, worked examples, and interactive science simulations."/>
  <meta name="theme-color" content="#0b1d32"/>
  <title>Physics & Mathematics Tutoring — Nicholas Perikli</title>
</head>
<body class="tutor-shell">
<header><div class="container nav"><a class="brand" href="/" aria-label="Nicholas Perikli portfolio home"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><nav aria-label="Primary"><a href="/">Portfolio</a><a href="/case-studies">Case Studies</a><a href="/tutoring" aria-current="page">Tutoring</a><a href="/about">About</a><a class="cta" href={enquiry}>Enquire</a></nav></div></header>
<main>
<section class="tutor-hero">
 <div class="container tutor-hero-grid">
  <div>
   <div class="tutor-kicker">Mathematics · Physics · Clear thinking</div>
   <h1>Understand the <em>why</em>. Then master the how.</h1>
   <p class="tutor-subtitle">Physics and Mathematics make more sense when you can see what the equations actually mean. I teach concepts step by step, connect them to intuition, and build towards confident independent problem-solving.</p>
   <div class="tutor-pill-row"><span class="tutor-pill">High-school Mathematics</span><span class="tutor-pill">Physical Sciences</span><span class="tutor-pill">University Physics &amp; Mathematics</span><span class="tutor-pill">Astrophysics &amp; Quantum Mechanics</span></div>
   <div class="tutor-actions"><a class="cta" href={enquiry}>Enquire about a lesson</a><a class="cta secondary" href="/tutoring/lab/#browse">Explore interactive lab</a></div>
   <p class="tutor-micro" style="margin-top:18px">Lessons by arrangement · Ask about your syllabus, goals and preferred format.</p>
  </div>
  <div class="tutor-visual" aria-label="Illustration of a projectile's parabolic path, a sinusoidal wave and an annotated gradient">
   <div class="tutor-visual-top"><span>Understanding in motion</span><span class="tutor-lights" aria-hidden="true"><i></i><i></i><i></i></span></div>
   <svg viewBox="0 0 520 410" role="img" aria-label="Conceptual graphs of motion and changing rates">
    <defs><linearGradient id="tg" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#42c9e8"/><stop offset="1" stop-color="#8a94e9"/></linearGradient><pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="#34516b" stroke-width=".7" opacity=".55"/></pattern></defs>
    <rect width="520" height="410" fill="url(#grid)"/>
    <path d="M48 270 H482" stroke="#63869c" stroke-width="1.2"/><path d="M48 40 V326" stroke="#63869c" stroke-width="1.2"/>
    <path d="M65 269 Q257 -50 458 269" fill="none" stroke="url(#tg)" stroke-width="5" stroke-linecap="round"/>
    <path d="M65 269 Q257 -50 458 269 L458 269 L65 269Z" fill="#39c8dc" fill-opacity=".05"/>
    <circle cx="258" cy="107" r="8" fill="#a5f0ff" stroke="#b6eeff" stroke-width="2"/>
    <path d="M258 107 V270" stroke="#b1dae9" stroke-width="1.4" stroke-dasharray="5 6"/>
    <text x="273" y="185" fill="#e0f6ff" font-size="15" font-family="system-ui">hₘₐₓ</text>
    <text x="389" y="254" fill="#d6e9f3" font-size="14" font-family="system-ui">range →</text>
    <path d="M52 355 Q77 308 102 355 T152 355 T202 355 T252 355 T302 355 T352 355 T402 355 T452 355" fill="none" stroke="#6cc9b3" stroke-width="3" stroke-linecap="round"/>
    <text x="48" y="35" fill="#a4c7d9" font-size="12" font-family="system-ui" letter-spacing="2">y</text>
    <text x="463" y="288" fill="#a4c7d9" font-size="12" font-family="system-ui">x</text>
    <text x="47" y="398" fill="#94b9cc" font-size="12" font-family="system-ui">A graph is a story, not just a picture.</text>
   </svg>
   <div class="visual-foot">Change a variable. Watch the result. Connect the picture to the mathematics.</div>
  </div>
 </div>
</section>

<div class="tutor-qualifications"><div class="container qualification-row"><strong>Academic background</strong><span>MSc Physics</span><span>BSc Honours Physics</span><span>BSc Astronomy &amp; Astrophysics</span><span>BSc Biological Sciences</span></div></div>
<section class="tutor-section qualifications-section" id="qualifications">
 <div class="container">
  <div class="tutor-section-head"><span class="tutor-kicker">Your tutor</span><h2>Physics research, academic depth, and a focus on understanding.</h2><p>I'm Nicholas Perikli, a Physics graduate and researcher with a background spanning particle physics, astronomy and astrophysics. I aim to make demanding ideas accessible without losing the mathematics that makes them precise.</p></div>
  <div class="qualification-cards">
   <article><span>2025 · Postgraduate</span><h3>MSc Physics</h3><p>University of the Witwatersrand · Experimental particle physics research, including work on ATLAS Tile Calorimeter alarm classification and prediction.</p></article>
   <article><span>2021 · Postgraduate</span><h3>BSc Honours Physics</h3><p>Advanced physics study and mathematical foundations.</p></article>
   <article><span>2019 · Undergraduate</span><h3>BSc Astronomy &amp; Astrophysics</h3><p>Stellar, planetary and physical-science foundations.</p></article>
   <article><span>2016 · Undergraduate</span><h3>BSc Biological Sciences</h3><p>A complementary grounding in the natural sciences.</p></article>
  </div>
  <p class="tutor-micro qualification-note">Research experience includes former associate membership of the ATLAS Collaboration at CERN (2021–2023).</p>
 </div>
</section>

<section class="tutor-section">
 <div class="container">
  <div class="tutor-section-head"><span class="tutor-kicker">A better way to learn</span><h2>Build understanding that lasts beyond the next test.</h2><p>My aim is not to hand you an answer. It is to help you see the structure of a problem and know what to do when the question looks different.</p></div>
  <div class="tutor-three">
   <article class="tutor-feature"><span class="feature-no">01 / See it</span><h3>Intuition first</h3><p>Start with a picture, physical example or simple idea. Define each symbol before using the equation.</p></article>
   <article class="tutor-feature"><span class="feature-no">02 / Derive it</span><h3>Work through the maths</h3><p>Go line by line through the logic, with carefully chosen examples and explanations of why each step works.</p></article>
   <article class="tutor-feature"><span class="feature-no">03 / Own it</span><h3>Practise independently</h3><p>Try related problems, diagnose mistakes and develop methods you can reproduce without hints.</p></article>
  </div>
 </div>
</section>

<section class="tutor-section soft" id="subjects">
 <div class="container">
  <div class="tutor-section-head"><span class="tutor-kicker">What we can work on</span><h2>Lessons shaped around your level and the problems you face.</h2><p>From fundamentals through to more challenging concepts. The exact syllabus and session format are agreed before booking.</p></div>
  <div class="tutor-three">
   <article class="tutor-feature"><span class="feature-no">∑</span><h3>Mathematics</h3><p>For high-school learners and students revisiting their foundations.</p><ul><li>Algebra &amp; Functions</li><li>Trigonometry &amp; Geometry</li><li>Calculus &amp; Graphs</li><li>Exam Prep &amp; Problem-solving</li></ul></article>
   <article class="tutor-feature"><span class="feature-no">F = ma</span><h3>Physics &amp; Physical Sciences</h3><p>Connecting physical ideas, units, diagrams and equations.</p><ul><li>Mechanics &amp; Forces</li><li>Energy &amp; Momentum</li><li>Waves, Sound &amp; Light</li><li>Electricity &amp; Fields</li></ul></article>
   <article class="tutor-feature"><span class="feature-no">∂</span><h3>University Physics &amp; Mathematics</h3><p>University-level conceptual and mathematical support, tailored to your course.</p><ul><li>Calculus &amp; Math Methods</li><li>Mechanics &amp; Electrodynamics</li><li>Astronomy &amp; Astrophysics</li><li>Quantum &amp; Particle Physics</li></ul></article>
  </div>
 </div>
</section>

<section class="tutor-section navy-alt">
 <div class="container">
  <div class="tutor-section-head"><span class="tutor-kicker" style="color:#8fd7f0">Ten interactive demonstrations · Private preview</span><h2>Move the sliders. Make the concepts click.</h2><p>Explore ten original Mathematics and Physics simulations, from introductory calculus to Astrophysics and Quantum Mechanics. Select any card for equations, adjustable controls and interpretations.</p></div>
  <div class="tutor-three">
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true"><path d="M15 103 H325 M15 10 V103" stroke="#7b96ad" fill="none"/><path d="M20 101Q170 -72 320 101" stroke="#61d4ec" stroke-width="4" fill="none"/><circle cx="170" cy="17" r="6" fill="#e9fbff"/></svg></div><div class="example-copy"><span class="example-level">Core concept</span><strong>Projectile motion</strong><p>Change speed, angle and gravity to discover what controls flight time, height and range.</p><a href="/tutoring/lab#motion">Launch the simulation →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true"><path d="M15 103 H325 M170 5 V115" stroke="#7b96ad" fill="none"/><path d="M38 100 Q130 95 170 60 T300 9" stroke="#79ceaa" stroke-width="4" fill="none"/><path d="M35 100 L305 7" stroke="#ffd47a" stroke-width="2.5" stroke-dasharray="8 5"/></svg></div><div class="example-copy"><span class="example-level">Core concept</span><strong>Derivatives &amp; tangents</strong><p>Watch a secant approach a tangent and see how the derivative emerges from a limit.</p><a href="/tutoring/lab#calculus">Explore gradients →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true"><path d="M10 60 H330" stroke="#7b96ad"/><path d="M10 60Q35 5 60 60T110 60T160 60T210 60T260 60T310 60" stroke="#68d4ef" stroke-width="3" fill="none"/><path d="M10 60Q35 115 60 60T110 60T160 60T210 60T260 60T310 60" stroke="#c4a5ff" stroke-width="3" fill="none"/></svg></div><div class="example-copy"><span class="example-level">Core concept</span><strong>Wave interference</strong><p>Combine two waves and explore reinforcement, cancellation and phase differences.</p><a href="/tutoring/lab#waves">Combine the waves →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <ellipse cx="171" cy="60" rx="109" ry="42" fill="none" stroke="#64d0e9" stroke-width="2.7"/>
    <path d="M106 60L246 31" stroke="#a7c9db" stroke-width="1.7" stroke-dasharray="5 5"/>
    <circle cx="106" cy="60" r="13" fill="#ffd37c" fill-opacity=".17"/><circle cx="106" cy="60" r="7" fill="#ffd37c" stroke="#fff0cd" stroke-width="1.2"/>
    <circle cx="246" cy="31" r="7" fill="#9aceff" stroke="#e0f6ff" stroke-width="1.5"/>
    <path d="M250 23l11 -9" stroke="#9aceff" stroke-width="1.5" stroke-linecap="round"/>
    </svg></div><div class="example-copy"><span class="example-level">University level</span><strong>Keplerian orbits</strong><p>Change orbital eccentricity and size. Explore how distance, speed and orbital period change.</p><a href="/tutoring/lab/astrophysics">Explore orbital motion →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <circle cx="170" cy="60" r="48" stroke="#80b7ce" stroke-width="1.5" fill="#193f58" fill-opacity=".5"/>
    <ellipse cx="170" cy="60" rx="48" ry="15" stroke="#718fa5" stroke-width="1.3" stroke-dasharray="5 4" fill="none"/>
    <path d="M170 8V112M123 60H217" stroke="#6e90a7" stroke-width="1.3" fill="none"/>
    <path d="M170 60L204 26" stroke="#ffd78d" stroke-width="3" stroke-linecap="round"/>
    <path d="M204 26L196 28M204 26L202 34" stroke="#ffd78d" stroke-width="2" fill="none"/>
    <circle cx="204" cy="26" r="4" fill="#ffdb9e"/>
    <text x="226" y="25" fill="#b8daec" font-size="14" font-family="system-ui">|ψ⟩</text>
    <text x="183" y="12" fill="#b8daec" font-size="13" font-family="system-ui">|0⟩</text>
    <text x="183" y="118" fill="#b8daec" font-size="13" font-family="system-ui">|1⟩</text>
    </svg></div><div class="example-copy"><span class="example-level">University level</span><strong>Qubit state &amp; measurement</strong><p>Change a quantum state's phase and amplitudes, then compare measurement probabilities in different bases.</p><a href="/tutoring/lab/quantum">Explore quantum states →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <path d="M25 100H317M25 12V100" stroke="#7394ab" stroke-width="1.2" fill="none"/>
    <path d="M40 91 Q116 94 156 43 Q215 -5 305 23" stroke="#ffd47a" stroke-width="3.5" fill="none"/>
    <g fill="#50cfe2" fill-opacity=".42" stroke="#6cd9e9" stroke-width="1"><rect x="42" y="83" width="30" height="17"/><rect x="73" y="71" width="30" height="29"/><rect x="104" y="55" width="30" height="45"/><rect x="135" y="38" width="30" height="62"/><rect x="166" y="26" width="30" height="74"/><rect x="197" y="17" width="30" height="83"/><rect x="228" y="13" width="30" height="87"/></g>
    </svg></div><div class="example-copy"><span class="example-level">Mathematics</span><strong>Integration &amp; Riemann sums</strong><p>Change the number of rectangles and explore how signed areas approach a definite integral.</p><a href="/tutoring/lab/integration">Explore integration →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <circle cx="100" cy="60" r="9" fill="#e8aaaa"/><circle cx="240" cy="60" r="9" fill="#8bcdf4"/>
    <g stroke="#7ed3e9" stroke-width="2" fill="none"><path d="M111 59 Q169 8 229 59"/><path d="M111 62 Q169 112 229 62"/><path d="M100 49 Q145 1 240 49"/><path d="M100 72 Q145 118 240 72"/><path d="M110 60H230"/></g>
    <path d="M162 57l8 3-8 3M164 22l10-4-4 10M164 98l10 4-4-10" stroke="#d9f0fa" stroke-width="2" fill="none"/>
    </svg></div><div class="example-copy"><span class="example-level">Classical Physics</span><strong>Electric fields &amp; potential</strong><p>Adjust positive and negative charges to reveal field directions and equipotential contours.</p><a href="/tutoring/lab/electric-fields">Explore electric fields →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <path d="M24 99H318M24 16V99" stroke="#7394ab" fill="none"/>
    <rect x="67" y="17" width="38" height="82" fill="#7dc4e5" fill-opacity=".14"/>
    <path d="M24 99C43 98 69 86 85 54S119 19 146 25S188 58 219 78S274 94 314 97" fill="none" stroke="#ffd37c" stroke-width="4"/>
    <path d="M24 99C49 99 78 95 102 83S145 52 172 44S211 42 241 59S286 89 314 94" fill="none" stroke="#bdacff" stroke-dasharray="6 5" stroke-width="2.3"/>
    </svg></div><div class="example-copy"><span class="example-level">Astronomy &amp; Astrophysics</span><strong>Stellar spectra &amp; temperature</strong><p>Change stellar temperature to see how blackbody emission and peak wavelength shift.</p><a href="/tutoring/lab/stellar-spectra">Explore stellar spectra →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <path d="M30 62H310M170 5V114" stroke="#8aa9bf" stroke-width="1.4"/>
    <path d="M103 5L237 114M237 5L103 114" stroke="#ffd783" stroke-width="2" stroke-dasharray="6 4"/>
    <path d="M130 114L210 5" stroke="#76d3be" stroke-width="3.1"/>
    <path d="M30 92L310 31" stroke="#bbabf8" stroke-width="2.7"/>
    <circle cx="195" cy="37" r="6" fill="#ffabc3" stroke="#fff2f4" stroke-width="1.5"/>
    </svg></div><div class="example-copy"><span class="example-level">Modern Physics</span><strong>Spacetime explorer</strong><p>Tilt reference-frame axes and explore time dilation, length contraction and Lorentz transformations.</p><a href="/tutoring/lab/spacetime">Explore spacetime →</a></div></article>
   <article class="tutor-example"><div class="example-art"><svg viewBox="0 0 340 120" aria-hidden="true">
    <path d="M38 14V107M302 14V107M38 105H302" stroke="#a4bfd0" stroke-width="2" fill="none"/>
    <path d="M38 60Q70 10 102 60T166 60T230 60T294 60" stroke="#c4a6ff" stroke-width="3" fill="none"/>
    <path d="M38 105Q70 19 102 105T166 105T230 105T294 105" stroke="#5dd7ed" stroke-width="2.5" fill="none"/>
    <path d="M38 14H302" stroke="#536f89" stroke-dasharray="4 5"/>
    </svg></div><div class="example-copy"><span class="example-level">Quantum Mechanics</span><strong>Quantum particle in a box</strong><p>Explore discrete energy levels and the difference between wavefunctions and probabilities.</p><a href="/tutoring/lab/particle-box">Explore the quantum well →</a></div></article>
  </div>
  <div class="tutor-actions" style="margin-top:28px"><a class="cta" href="/tutoring/lab/#browse">Open the full interactive lab</a></div>
 </div>
</section>

<section class="tutor-section soft" id="coming-soon">
 <div class="container">
  <div class="tutor-section-head"><span class="tutor-kicker">Learning resources in development</span><h2>Study notes and a video lesson series are on the way.</h2><p>I'm developing additional materials to complement tutoring sessions and the interactive lab. These resources are still in progress and are not yet published.</p></div>
  <div class="inprogress-grid">
   <article class="inprogress-card"><span class="work-status">In Progress</span><h3>Structured Study Notes</h3><p>Concept-first written explanations, step-by-step derivations, worked examples and practice problems for Mathematics and Physics, with advanced topics planned.</p></article>
   <article class="inprogress-card"><span class="work-status">In Progress</span><h3>Physics &amp; Mathematics Video Series</h3><p>A planned series of visual lessons connecting physical intuition, equations, demonstrations and guided problem-solving. Videos will be added once produced and verified.</p></article>
  </div>
  <p class="tutor-micro" style="margin-top:20px">No release date is being announced yet. The interactive simulations above are available now on this private preview.</p>
 </div>
</section>

<section class="tutor-section" id="enquire">
 <div class="container tutor-bottom">
  <div><span class="tutor-kicker">Let's work on it together</span><h2>Tell me what you're struggling with.</h2><p>Include the learner's level, topics, goals and preferred lesson format. I'll reply so we can discuss whether the tutoring is a good fit. No booking or payment is made on this website.</p><p class="tutor-micro">Based in Gauteng, South Africa · Session arrangements confirmed individually.</p></div>
  <a class="cta" href={enquiry}>Email a tutoring enquiry →</a>
 </div>
</section>
</main>
<footer><div class="container footer-grid"><a class="brand" href="/"><div class="monogram"><span>N</span><span>P</span></div><span class="wordmark">Nicholas Perikli</span></a><div class="small"><a href="/">Portfolio</a> · <a href="/tutoring/lab/#browse">Interactive Lab</a> · <a href="mailto:nicholasperikli@gmail.com">Email</a></div></div></footer>
</body>
</html>
